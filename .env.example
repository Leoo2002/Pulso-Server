# Secretos de autenticación
JWT_SECRET=your_jwt_secret_here
U_SECRET=your_special_access_password

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Frontend
FRONTEND_URL=https://your-frontend-url.com

# Configuración de acceso especial
DEFAULT_MAIL_LIDER=admin@empresa.com
ACCESO_ESPECIAL_EMAIL=dev@empresa.com
ACCESO_ESPECIAL_HD=empresa.com

# ============================================================================
# 📧 NOTIFICACIONES POR EMAIL - Alertas de Seguridad
# ============================================================================
MAIL_ALERTS_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu_email@gmail.com
MAIL_PASS=tu_contraseña_o_app_password
MAIL_FROM=seguridad@pulso.com
MAIL_ALERTS_TO=leonel.quiroga@konecta.com

# ============================================================================
# 🔔 NOTIFICACIONES POR SLACK - Alertas de Seguridad
# ============================================================================
# URL del Webhook: https://api.slack.com/apps > Incoming Webhooks
SLACK_WEBHOOK_URL=

# ============================================================================
# 🎮 NOTIFICACIONES POR DISCORD - Alertas de Seguridad
# ============================================================================
# URL del Webhook: Discord Servidor > Canal > Integraciones > Webhooks
DISCORD_WEBHOOK_URL=
